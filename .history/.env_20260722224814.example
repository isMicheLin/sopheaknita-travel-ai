# Create this key in Google AI Studio. Never upload your real .env file.
GEMINI_API_KE

# Current stable defaults used by this project
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# RAG configuration
CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32
